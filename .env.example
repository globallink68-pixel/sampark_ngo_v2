# Safe to expose in the browser: API base, Razorpay Key ID, and Turnstile site key only.
VITE_API_BASE_URL=
VITE_RAZORPAY_KEY_ID=
VITE_TURNSTILE_SITE_KEY=
# H1 Express/Hostinger server settings: never prefix these with VITE_ or commit real values.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
SESSION_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
